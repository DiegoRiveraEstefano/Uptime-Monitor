<Layouts.flash_group flash={@flash} />

<div class="bg-white min-h-screen font-sans text-slate-900 antialiased relative overflow-hidden">
  <!-- Subtle top glow background element -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-radial-gradient from-[hsl(268,100%,98%)] to-transparent opacity-75 pointer-events-none -z-10" />

  <!-- Hero Content -->
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-32 lg:px-8 text-center space-y-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[hsl(268,100%,97%)] border border-[hsl(268,90%,92%)] text-[hsl(268,50%,30%)] text-xs font-semibold tracking-wide animate-pulse">
      🛰️ MULTI-TENANT ENGINE READY
    </div>
    
    <h1 class="text-5xl sm:text-6xl font-extrabold text-slate-900 tracking-tight font-sans max-w-3xl mx-auto leading-tight sm:leading-none">
      Peace of mind for your <span class="text-[hsl(268,60%,50%)]">SaaS applications</span>
    </h1>
    
    <p class="text-lg text-slate-500 max-w-xl mx-auto font-normal leading-relaxed">
      Monitor availability, track response latencies, and dispatch webhook/slack notifications instantly. Multi-tenant isolation designed for team collaboration.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap justify-center items-center gap-4 pt-4">
      <a href="/register" class="bg-[hsl(268,80%,75%)] text-[hsl(268,50%,30%)] hover:bg-[hsl(268,65%,68%)] active:scale-98 transition-all duration-200 ease-in-out font-semibold px-6 py-3 rounded-xl shadow-sm hover:shadow-md cursor-pointer flex items-center gap-2 text-base">
        Get Started Free
        <UptimeMonitorWeb.CoreComponents.icon name="hero-arrow-right-micro" class="size-4" />
      </a>
      
      <a href="/login" class="bg-white text-slate-700 border border-slate-100 hover:bg-slate-50 active:scale-98 transition-all duration-200 ease-in-out font-semibold px-6 py-3 rounded-xl shadow-sm cursor-pointer text-base">
        Sign In
      </a>
    </div>

    <!-- Interface Preview / Showcase -->
    <div class="pt-16 max-w-4xl mx-auto">
      <div class="bg-slate-50 border border-slate-100 rounded-3xl p-6 sm:p-10 shadow-inner">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
          
          <!-- Mock Monitor 1 -->
          <div class="bg-white border border-slate-100 rounded-2xl p-6 shadow-sm">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h4 class="font-bold text-lg text-slate-900 font-sans tracking-tight">Main Payment Gateway</h4>
                <span class="text-xs text-slate-400 font-mono mt-1 block">https://api.stripe.com/v3/charges</span>
              </div>
              <span class="px-3 py-1 rounded-full text-xs font-semibold inline-flex items-center gap-1.5 border bg-emerald-50 text-emerald-700 border-emerald-100">
                <span class="size-2 rounded-full bg-emerald-500" />
                ONLINE
              </span>
            </div>
            
            <div class="grid grid-cols-2 gap-4 border-t border-slate-50 pt-4 mt-2">
              <div>
                <span class="block text-[10px] uppercase font-semibold text-slate-400 tracking-wider">Uptime (30d)</span>
                <span class="text-base font-bold text-slate-800">99.98%</span>
              </div>
              <div>
                <span class="block text-[10px] uppercase font-semibold text-slate-400 tracking-wider">Latency</span>
                <span class="text-base font-bold text-slate-800">112ms</span>
              </div>
            </div>
          </div>

          <!-- Mock Monitor 2 -->
          <div class="bg-white border border-slate-100 rounded-2xl p-6 shadow-sm">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h4 class="font-bold text-lg text-slate-900 font-sans tracking-tight">OAuth Auth Server</h4>
                <span class="text-xs text-slate-400 font-mono mt-1 block">https://auth.company.com/oauth/token</span>
              </div>
              <span class="px-3 py-1 rounded-full text-xs font-semibold inline-flex items-center gap-1.5 border bg-rose-50 text-rose-700 border-rose-100 animate-pulse">
                <span class="size-2 rounded-full bg-rose-500" />
                OUTAGE
              </span>
            </div>
            
            <div class="grid grid-cols-2 gap-4 border-t border-slate-50 pt-4 mt-2">
              <div>
                <span class="block text-[10px] uppercase font-semibold text-slate-400 tracking-wider">Uptime (30d)</span>
                <span class="text-base font-bold text-slate-800">95.42%</span>
              </div>
              <div>
                <span class="block text-[10px] uppercase font-semibold text-slate-400 tracking-wider">Latency</span>
                <span class="text-base font-bold text-slate-800">5420ms</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Features Grid -->
  <div class="mx-auto max-w-5xl px-6 pb-24 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Feature 1 -->
      <div class="space-y-3">
        <div class="size-10 rounded-xl bg-[hsl(268,100%,97%)] text-[hsl(268,50%,50%)] flex items-center justify-center border border-[hsl(268,90%,92%)]">
          <UptimeMonitorWeb.CoreComponents.icon name="hero-cpu-chip" class="size-5" />
        </div>
        <h3 class="text-lg font-bold font-sans text-slate-900">OTP Concurrency Engine</h3>
        <p class="text-sm text-slate-500 leading-relaxed">
          Supervised GenServers execute target requests concurrently inside the Erlang VM, guaranteeing fault isolation and sub-second accuracy.
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="space-y-3">
        <div class="size-10 rounded-xl bg-[hsl(268,100%,97%)] text-[hsl(268,50%,50%)] flex items-center justify-center border border-[hsl(268,90%,92%)]">
          <UptimeMonitorWeb.CoreComponents.icon name="hero-users" class="size-5" />
        </div>
        <h3 class="text-lg font-bold font-sans text-slate-900">Multi-Tenant Workspaces</h3>
        <p class="text-sm text-slate-500 leading-relaxed">
          Strong database row-level isolation scopes all monitors, alerts, and dashboards to your team. Invite members with distinct roles.
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="space-y-3">
        <div class="size-10 rounded-xl bg-[hsl(268,100%,97%)] text-[hsl(268,50%,50%)] flex items-center justify-center border border-[hsl(268,90%,92%)]">
          <UptimeMonitorWeb.CoreComponents.icon name="hero-bell" class="size-5" />
        </div>
        <h3 class="text-lg font-bold font-sans text-slate-900">Integrated Alerting</h3>
        <p class="text-sm text-slate-500 leading-relaxed">
          Route incidents to email, custom Slack channels, or outgoing webhooks with automatic alert grouping to prevent spam.
        </p>
      </div>

    </div>
  </div>
</div>
