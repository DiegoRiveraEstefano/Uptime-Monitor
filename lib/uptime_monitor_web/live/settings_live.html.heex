<Layouts.app flash={@flash}>
  <div class="space-y-12 pb-24">
    <!-- Top Workspace Header -->
    <div class="space-y-4">
      <a
        href={~p"/org/#{@current_tenant.slug}"}
        class="text-xs font-semibold text-slate-500 hover:text-[hsl(268,60%)] flex items-center gap-1"
      >
        &larr; Back to Dashboard
      </a>

      <div class="border-b border-slate-100 pb-6">
        <h1 class="text-3xl font-extrabold font-sans text-slate-900 tracking-tight">
          Workspace Settings
        </h1>
        <p class="text-xs text-slate-400 mt-1">
          Configure details, notification integrations, and access control for {@current_tenant.name}
        </p>
      </div>
    </div>

    <!-- Section 1: General Details -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 border-b border-slate-100 pb-10">
      <div>
        <h3 class="font-bold text-lg text-slate-900">General Information</h3>
        <p class="text-xs text-slate-400 mt-1">
          Rename your workspace or update its URL identifier. Modifying the slug will change your dashboard link.
        </p>
      </div>

      <div class="md:col-span-2 bg-white border border-slate-100 rounded-3xl p-6 sm:p-8 shadow-sm">
        <.form for={@tenant_form} phx-submit="save_tenant" id="workspace-form" class="space-y-4">
          <UptimeComponents.custom_input
            field={@tenant_form[:name]}
            label="Workspace Name"
            placeholder="e.g. Acme Corp"
            disabled={@current_role not in ["owner", "admin"]}
          />

          <UptimeComponents.custom_input
            field={@tenant_form[:slug]}
            label="Workspace Slug URL"
            placeholder="e.g. acme-corp"
            disabled={@current_role not in ["owner", "admin"]}
          />

          <div :if={@current_role in ["owner", "admin"]} class="pt-2 flex justify-end">
            <UptimeComponents.primary_button type="submit" id="save-workspace-btn">
              Save Workspace
            </UptimeComponents.primary_button>
          </div>
        </.form>
      </div>
    </div>

    <!-- Section 2: Members & Access Control -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 border-b border-slate-100 pb-10">
      <div>
        <h3 class="font-bold text-lg text-slate-900">Workspace Members</h3>
        <p class="text-xs text-slate-400 mt-1">
          Manage team access levels. Users must have a registered account to be added to this workspace.
        </p>
      </div>

      <div class="md:col-span-2 space-y-6">
        <!-- Invite Form -->
        <div
          :if={@current_role in ["owner", "admin"]}
          class="bg-slate-50 border border-slate-100 rounded-3xl p-6 shadow-sm"
        >
          <h4 class="font-bold text-sm text-slate-800 mb-3">Add Team Member</h4>

          <.form
            for={@invite_form}
            phx-submit="invite_member"
            id="invite-form"
            class="flex flex-col sm:flex-row items-end gap-4"
          >
            <div class="flex-1 w-full">
              <label class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mb-1.5">User Email</label>
              <input
                type="email"
                name="invite[email]"
                value={@invite_form[:email].value}
                placeholder="name@company.com"
                required
                class="w-full bg-white text-slate-900 border border-slate-150 focus:border-[hsl(268,80%)] focus:ring-1 focus:ring-[hsl(268,80%)] outline-none rounded-xl px-4 py-2.5 text-sm transition-all duration-150"
              />
            </div>

            <div class="w-full sm:w-40">
              <label class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Access Role</label>
              <select
                name="invite[role]"
                class="w-full bg-white text-slate-900 border border-slate-150 focus:border-[hsl(268,80%)] focus:ring-1 focus:ring-[hsl(268,80%)] outline-none rounded-xl px-3 py-2.5 text-sm transition-all duration-150"
              >
                <option value="viewer">Viewer</option>
                <option value="editor">Editor</option>
                <option value="admin">Admin</option>
                <option value="owner">Owner</option>
              </select>
            </div>

            <UptimeComponents.primary_button
              type="submit"
              id="add-member-btn"
              class="shrink-0 w-full sm:w-auto"
            >
              Add Member
            </UptimeComponents.primary_button>
          </.form>
        </div>

        <!-- Members Listing -->
        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
          <table class="w-full text-left text-sm divide-y divide-slate-100">
            <thead class="bg-slate-50 text-[10px] uppercase font-semibold text-slate-500 tracking-wider">
              <tr>
                <th class="px-6 py-3.5">Email</th>
                <th class="px-6 py-3.5">Role</th>
                <th class="px-6 py-3.5 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              <tr :for={member <- @members} class="hover:bg-slate-50/50 transition-colors">
                <td class="px-6 py-4">
                  <div class="font-medium text-slate-900">{member.user.email}</div>
                  <div
                    :if={member.user.id == @current_user.id}
                    class="text-[10px] text-slate-400 font-medium mt-0.5"
                  >
                    Your Account
                  </div>
                </td>
                <td class="px-6 py-4">
                  <%= if @current_role in ["owner", "admin"] && member.user.id != @current_user.id && member.role != "owner" do %>
                    <select
                      name="role"
                      phx-change="change_role"
                      phx-value-user-id={member.user.id}
                      class="bg-white border border-slate-100 rounded-lg px-2 py-1 text-xs text-slate-700 outline-none focus:border-[hsl(268,60%)]"
                    >
                      <option value="viewer" selected={member.role == "viewer"}>Viewer</option>
                      <option value="editor" selected={member.role == "editor"}>Editor</option>
                      <option value="admin" selected={member.role == "admin"}>Admin</option>
                      <option value="owner" selected={member.role == "owner"}>Owner</option>
                    </select>
                  <% else %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-50 text-slate-600 border border-slate-100 uppercase">
                      {member.role}
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right">
                  <button
                    :if={
                      @current_role in ["owner", "admin"] && member.user.id != @current_user.id &&
                        member.role != "owner"
                    }
                    phx-click="remove_member"
                    phx-value-user-id={member.user.id}
                    data-confirm="Are you sure you want to remove this member from the workspace?"
                    class="text-xs text-rose-600 hover:text-rose-900 font-semibold hover:underline cursor-pointer"
                  >
                    Remove
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Section 3: Notification Integrations -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-bold text-lg text-slate-900">Notification Channels</h3>
        <p class="text-xs text-slate-400 mt-1">
          Connect Slack webhooks, email lists, or generic API webhooks to dispatch system downtime alerts.
        </p>
      </div>

      <div class="md:col-span-2 space-y-6">
        <!-- Add Integration Form -->
        <div
          :if={@current_role in ["owner", "admin"]}
          class="bg-slate-50 border border-slate-100 rounded-3xl p-6 shadow-sm"
        >
          <h4 class="font-bold text-sm text-slate-800 mb-3">Add Alert Integration</h4>

          <.form for={@channel_form} phx-submit="save_channel" id="channel-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Channel Type</label>
                <select
                  name="channel[type]"
                  class="w-full bg-white text-slate-900 border border-slate-150 focus:border-[hsl(268,80%)] focus:ring-1 focus:ring-[hsl(268,80%)] outline-none rounded-xl px-3 py-2.5 text-sm transition-all duration-150"
                >
                  <option value="email">Email Notification</option>
                  <option value="slack">Slack Incoming Webhook</option>
                  <option value="webhook">Generic HTTP Webhook</option>
                </select>
              </div>

              <div class="sm:col-span-2">
                <label class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Integration Target / Endpoint</label>
                <input
                  type="text"
                  name="channel[target]"
                  value={@channel_form[:target].value}
                  placeholder="e.g. alerts@company.com or webhook URL"
                  required
                  class="w-full bg-white text-slate-900 border border-slate-150 focus:border-[hsl(268,80%)] focus:ring-1 focus:ring-[hsl(268,80%)] outline-none rounded-xl px-4 py-2.5 text-sm transition-all duration-150"
                />
              </div>
            </div>

            <div class="pt-2 flex justify-end">
              <UptimeComponents.primary_button type="submit" id="add-channel-btn">
                Add Integration
              </UptimeComponents.primary_button>
            </div>
          </.form>
        </div>

        <!-- Channels Listing -->
        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
          <div :if={@channels == []} class="p-8 text-center text-slate-400 text-sm">
            No alert integrations configured yet. All incident alerts will only be logged inside the in-app box.
          </div>

          <table :if={@channels != []} class="w-full text-left text-sm divide-y divide-slate-100">
            <thead class="bg-slate-50 text-[10px] uppercase font-semibold text-slate-500 tracking-wider">
              <tr>
                <th class="px-6 py-3.5">Type</th>
                <th class="px-6 py-3.5">Target</th>
                <th class="px-6 py-3.5">Status</th>
                <th class="px-6 py-3.5 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              <tr :for={channel <- @channels} class="hover:bg-slate-50/50 transition-colors">
                <td class="px-6 py-4">
                  <span class={[
                    "px-2 py-0.5 rounded-full text-[10px] font-bold border uppercase",
                    channel.type == "email" && "bg-blue-50 text-blue-700 border-blue-100",
                    channel.type == "slack" && "bg-purple-50 text-purple-700 border-purple-100",
                    channel.type == "webhook" && "bg-slate-50 text-slate-700 border-slate-100"
                  ]}>
                    {channel.type}
                  </span>
                </td>
                <td class="px-6 py-4 font-mono text-xs text-slate-600 truncate max-w-xs">
                  {Map.get(channel.config, "to") || Map.get(channel.config, "webhook_url") ||
                    Map.get(channel.config, "url") || "-"}
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center gap-1 text-xs text-emerald-600 font-semibold">
                    <span class="size-1.5 rounded-full bg-emerald-500" /> ACTIVE
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <button
                    :if={@current_role in ["owner", "admin"]}
                    phx-click="delete_channel"
                    phx-value-id={channel.id}
                    data-confirm="Are you sure you want to delete this alert integration?"
                    class="text-xs text-rose-600 hover:text-rose-900 font-semibold hover:underline cursor-pointer"
                  >
                    Delete
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
