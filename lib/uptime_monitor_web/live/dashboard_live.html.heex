<Layouts.app flash={@flash}>
  <div class="space-y-8 pb-24">
    <!-- Top Workspace Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-100 pb-6">
      <div>
        <h1 class="text-3xl font-extrabold font-sans text-slate-900 tracking-tight">
          {@current_tenant.name}
        </h1>
        <p class="text-xs text-slate-400 mt-1">
          Logged in as {@current_user.email} (Role: {@current_role})
        </p>
      </div>

      <div class="flex items-center gap-3">
        <!-- New Monitor toggle button -->
        <UptimeComponents.primary_button phx-click="toggle_create_form" id="toggle-monitor-btn">
          <.icon name="hero-plus-micro" class="size-4" /> Add Monitor
        </UptimeComponents.primary_button>

        <!-- Logout button -->
        <.form for={%{}} action={~p"/logout"} method="delete" id="logout-form">
          <UptimeComponents.secondary_button type="submit" id="logout-btn">
            Log Out
          </UptimeComponents.secondary_button>
        </.form>
      </div>
    </div>

    <!-- Active Incident Alerts Box -->
    <div
      :if={@unread_notifications != []}
      class="bg-rose-50 border border-rose-100 rounded-2xl p-5 space-y-3"
    >
      <h3 class="text-sm font-bold text-rose-800 uppercase tracking-wider flex items-center gap-1.5">
        <.icon name="hero-exclamation-triangle" class="size-5 shrink-0 text-rose-600" />
        Unread System Alerts
      </h3>
      <div class="divide-y divide-rose-100/50">
        <div
          :for={notif <- @unread_notifications}
          class="flex items-center justify-between py-2 gap-4"
        >
          <div class="text-xs text-rose-900">
            <span class="font-bold">{notif.title}:</span> {notif.message}
          </div>
          <button
            phx-click="mark_read"
            phx-value-id={notif.id}
            class="text-[10px] uppercase font-bold text-rose-700 hover:text-rose-900 cursor-pointer"
          >
            Mark read
          </button>
        </div>
      </div>
    </div>

    <!-- Metrics Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <UptimeComponents.metric_card
        title="Avg Workspace SLA"
        value={"#{@global_sla}%"}
        trend={if @global_sla == "100.0", do: "up", else: "neutral"}
      />

      <UptimeComponents.metric_card
        title="Avg Response Latency"
        value={"#{@avg_latency}ms"}
        trend="neutral"
      />

      <UptimeComponents.metric_card
        title="Outages Grouped"
        value={"#{length(@incidents)}"}
        trend={if @incidents == [], do: "up", else: "down"}
      />
    </div>

    <!-- Create Monitor Inline Form (Toggleable) -->
    <div
      :if={@show_create_form}
      class="bg-slate-50 border border-slate-100 rounded-2xl p-6 max-w-lg mx-auto shadow-sm"
    >
      <h3 class="font-bold text-lg text-slate-800 font-sans tracking-tight mb-4">
        Add Uptime Monitor
      </h3>

      <.form
        for={@new_monitor_form}
        phx-submit="save_monitor"
        id="new-monitor-form"
        class="space-y-4"
      >
        <UptimeComponents.custom_input
          field={@new_monitor_form[:name]}
          label="Monitor Name"
          placeholder="e.g. Website Home"
          required
        />

        <UptimeComponents.custom_input
          field={@new_monitor_form[:url]}
          type="url"
          label="Checking URL"
          placeholder="https://example.com"
          required
        />

        <UptimeComponents.custom_input
          field={@new_monitor_form[:interval_seconds]}
          type="number"
          label="Check Interval (seconds)"
          placeholder="60"
          required
        />

        <div class="flex items-center justify-end gap-3 pt-2">
          <UptimeComponents.ghost_button phx-click="toggle_create_form" type="button">
            Cancel
          </UptimeComponents.ghost_button>
          <UptimeComponents.primary_button type="submit" id="save-monitor-submit">
            Save Monitor
          </UptimeComponents.primary_button>
        </div>
      </.form>
    </div>

    <!-- Monitor Stream Listing -->
    <div class="space-y-4">
      <h2 class="text-2xl font-bold font-sans text-slate-900 tracking-tight">Active Monitors</h2>

      <!-- Empty state styling -->
      <div id="monitors" phx-update="stream" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="hidden only:block bg-slate-50 border border-dashed border-slate-200 rounded-2xl p-8 text-center text-slate-400 text-sm">
          No monitors set up yet. Click "Add Monitor" above to begin tracking.
        </div>

        <div
          :for={{id, monitor} <- @streams.monitors}
          id={id}
          class="bg-white border border-slate-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between"
        >
          <div class="flex items-start justify-between gap-4 mb-4">
            <div>
              <h4 class="font-bold text-lg text-slate-900 font-sans tracking-tight">
                {monitor.name}
              </h4>
              <a
                href={monitor.url}
                target="_blank"
                class="text-xs text-slate-400 hover:text-[hsl(268,60%)] transition-colors flex items-center gap-1 mt-1 font-mono"
              >
                {monitor.url}
                <.icon name="hero-arrow-top-right-on-square" class="size-3" />
              </a>
            </div>

            <span class={[
              "px-2.5 py-0.5 rounded-full text-[10px] font-bold inline-flex items-center gap-1 border",
              monitor.active && "bg-emerald-50 text-emerald-700 border-emerald-100",
              !monitor.active && "bg-slate-50 text-slate-500 border-slate-100"
            ]}>
              {if monitor.active, do: "ACTIVE", else: "PAUSED"}
            </span>
          </div>

          <div class="flex items-center justify-between border-t border-slate-50 pt-4 mt-2">
            <a
              href={~p"/org/#{@current_tenant.slug}/monitors/#{monitor.id}"}
              class="text-xs text-[hsl(268,60%,50%)] hover:underline font-semibold flex items-center gap-1"
            >
              Inspect details <.icon name="hero-chevron-right-micro" class="size-3" />
            </a>

            <button
              phx-click="toggle_active"
              phx-value-id={monitor.id}
              class="text-xs text-slate-500 hover:text-slate-900 transition-colors font-medium cursor-pointer"
            >
              {if monitor.active, do: "Pause", else: "Resume"}
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Incident Outage Logs -->
    <div class="space-y-4 pt-4">
      <h2 class="text-2xl font-bold font-sans text-slate-900 tracking-tight">Outages Log</h2>

      <div class="bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm">
        <div :if={@incidents == []} class="p-8 text-center text-slate-400 text-sm">
          No outages recorded. All services healthy.
        </div>

        <table :if={@incidents != []} class="w-full text-left text-sm divide-y divide-slate-100">
          <thead class="bg-slate-50 text-[10px] uppercase font-semibold text-slate-500 tracking-wider">
            <tr>
              <th class="px-6 py-3">Monitor</th>
              <th class="px-6 py-3">Status</th>
              <th class="px-6 py-3">Opened At</th>
              <th class="px-6 py-3">Duration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            <tr :for={incident <- @incidents} class="hover:bg-slate-50/50 transition-colors">
              <td class="px-6 py-4 font-medium text-slate-900">{incident.monitor.name}</td>
              <td class="px-6 py-4">
                <span class={[
                  "px-2 py-0.5 rounded-full text-[10px] font-bold border",
                  incident.status == "open" && "bg-rose-50 text-rose-700 border-rose-100",
                  incident.status == "resolved" && "bg-slate-50 text-slate-600 border-slate-100"
                ]}>
                  {String.upcase(incident.status)}
                </span>
              </td>
              <td class="px-6 py-4 text-slate-500 font-mono text-xs">{incident.opened_at}</td>
              <td class="px-6 py-4 text-slate-500 font-medium">
                {if incident.status == "open",
                  do: "Ongoing",
                  else: "#{incident.downtime_seconds}s"}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layouts.app>
